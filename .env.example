# FounderOS bootstrap/deployment environment template.
# Copy only the settings your deployment needs to `.env.local` (local) or your
# infrastructure secret store (hosted). Provider credentials do NOT belong
# here: configure OpenAI and all connectors in the FounderOS Settings UI.
# Keep this tracked file placeholder-only.

# Core runtime
APP_ENV=<environment>
APP_NAME=<app-name>
API_BASE_URL=<backend-public-base-url>
DATABASE_URL=<postgres-database-url>
REDIS_URL=<redis-url>
RAW_STORAGE_DIR=<raw-storage-directory>
FOUNDEROS_LOG_LEVEL=<log-level>
FOUNDEROS_READINESS_DATABASE_TIMEOUT_SECONDS=<readiness-timeout-seconds>

# Backend API auth and secret encryption
# Fail-closed posture: any non-local APP_ENV (e.g. production/private-beta)
# must set API_AUTH_ENABLED=true with a configured API_AUTH_KEY (or
# FOUNDEROS_API_KEYS), or the backend refuses to start. Auth may stay disabled
# only when APP_ENV is local/dev/test.
API_AUTH_ENABLED=<true-or-false>
API_AUTH_KEY=<operator-api-key>
API_AUTH_HEADER_NAME=<api-key-header-name>
FOUNDEROS_API_KEYS=<comma-separated-api-keys>
# Dedicated secret-encryption key. REQUIRED outside local/dev: when APP_ENV is
# non-local and this is unset, the backend fails closed instead of reusing
# API_AUTH_KEY as encryption material. On the first bootstrap of a legacy local
# install, the existing API_AUTH_KEY is promoted into this dedicated setting so
# already-encrypted tokens remain usable. Rotating it requires a deliberate
# credential re-encryption plan.
FOUNDEROS_SECRET_ENCRYPTION_KEY=<stable-encryption-key>

# Email+password login: server-side session cookie + brute-force throttle.
# The cookie Secure flag follows APP_ENV (Secure unless local/dev/test), so there
# is no separate cookie-secure toggle.
FOUNDEROS_SESSION_TTL_DAYS=<session-ttl-days>
FOUNDEROS_SESSION_COOKIE_NAME=<session-cookie-name>
FOUNDEROS_SESSION_COOKIE_SAMESITE=<lax-or-strict>
# Avoid a database write on every authenticated request while retaining useful
# recent-activity metadata.
FOUNDEROS_SESSION_LAST_SEEN_INTERVAL_SECONDS=<last-seen-write-interval-seconds>
FOUNDEROS_LOGIN_MAX_FAILED_ATTEMPTS=<max-failed-login-attempts>
FOUNDEROS_LOGIN_LOCKOUT_MINUTES=<login-lockout-minutes>
# Pre-Argon2 admission for login, founder enrollment and password setup.
# `process` is only for the documented single-process local runtime. Select
# `redis` before adding Uvicorn workers or backend replicas.
FOUNDEROS_LOGIN_RATE_LIMIT_WINDOW_SECONDS=<login-rate-limit-window-seconds>
FOUNDEROS_LOGIN_RATE_LIMIT_PER_IP=<login-rate-limit-per-ip>
FOUNDEROS_LOGIN_RATE_LIMIT_GLOBAL=<login-rate-limit-global>
FOUNDEROS_LOGIN_MAX_CONCURRENT_ATTEMPTS=<login-max-concurrent-attempts>
FOUNDEROS_LOGIN_RATE_LIMIT_BACKEND=<process-or-redis>
FOUNDEROS_LOGIN_RATE_LIMIT_REDIS_TIMEOUT_SECONDS=<redis-timeout-seconds>
# Forwarded client addresses are ignored unless both the feature and exact
# trusted proxy CIDRs are configured.
FOUNDEROS_TRUST_PROXY_HEADERS=<true-or-false>
FOUNDEROS_TRUSTED_PROXY_CIDRS=<comma-separated-proxy-cidrs>
# DB login_attempt rows older than this are removed opportunistically on failure.
FOUNDEROS_LOGIN_ATTEMPT_RETENTION_HOURS=<login-attempt-retention-hours>
FOUNDEROS_AUTH_ARTIFACT_CLEANUP_INTERVAL_SECONDS=<cleanup-interval-seconds>
FOUNDEROS_REVOKED_SESSION_RETENTION_HOURS=<revoked-session-retention-hours>
# Read-only assistant admission. These controls are process-local for the
# current single-process runtime; multi-worker/public operation needs a shared
# limiter before it is supported.
FOUNDEROS_ASSISTANT_QUERY_RATE_LIMIT_WINDOW_SECONDS=<assistant-rate-window-seconds>
FOUNDEROS_ASSISTANT_QUERY_RATE_LIMIT_PER_USER_WORKSPACE=<assistant-rate-per-user-workspace>
FOUNDEROS_ASSISTANT_QUERY_TIMEOUT_SECONDS=<assistant-timeout-seconds>

# Backend CORS
FOUNDEROS_CORS_ALLOWED_ORIGINS=<comma-separated-frontend-origins>
FOUNDEROS_CORS_ALLOW_CREDENTIALS=<true-or-false>
CORS_ORIGINS=<comma-separated-frontend-origins>
CORS_ALLOW_CREDENTIALS=<true-or-false>

# Local browser/operator bootstrap
FOUNDEROS_API_BASE_URL=<backend-browser-base-url>
FOUNDEROS_DEV_API_KEY=<local-dev-api-key>
# Canonical `make local` keeps this false; browser users authenticate by session.
FOUNDEROS_ENABLE_BROWSER_DEV_CONFIG=<true-or-false>
FOUNDEROS_LOCAL_WORKSPACE_PATH=<project local workspace path>
# Repository Intelligence runtime staging. Must resolve outside the FounderOS
# repository. RI-003 uses only synthetic local repositories; no target commands
# are executed and each checkout is deleted when its context exits.
FOUNDEROS_REPOSITORY_INTELLIGENCE_DATA_PATH=<external-ri-runtime-directory>
FOUNDEROS_REPOSITORY_INTELLIGENCE_CHECKOUT_TIMEOUT_SECONDS=<checkout-timeout-seconds>
FOUNDEROS_REPOSITORY_INTELLIGENCE_CHECKOUT_MAX_FILES=<checkout-file-count>
FOUNDEROS_REPOSITORY_INTELLIGENCE_CHECKOUT_MAX_BYTES=<checkout-total-bytes>
FOUNDEROS_REPOSITORY_INTELLIGENCE_CHECKOUT_MAX_FILE_BYTES=<checkout-file-bytes>
FOUNDEROS_REPOSITORY_INTELLIGENCE_CHECKOUT_MAX_COMMAND_OUTPUT_BYTES=<checkout-command-output-bytes>
FOUNDEROS_REPOSITORY_INTELLIGENCE_CHECKOUT_MAX_PATH_BYTES=<checkout-path-bytes>
FOUNDEROS_REPOSITORY_INTELLIGENCE_CHECKOUT_MAX_DEPTH=<checkout-path-depth>

# Local read-only smoke
FOUNDEROS_SMOKE_API_BASE_URL=http://127.0.0.1:3000
FOUNDEROS_SMOKE_API_KEY=<smoke-api-key>
FOUNDEROS_SMOKE_API_KEY_HEADER_NAME=<smoke-api-key-header-name>
FOUNDEROS_SMOKE_OWNER_EMAIL=<smoke-owner-email>
FOUNDEROS_SMOKE_WORKSPACE_ID=<smoke-workspace-id>
FOUNDEROS_SMOKE_EXPECT_AUTH=<true-or-false>
FOUNDEROS_SMOKE_TIMEOUT_SECONDS=<timeout-seconds>
# Used only by the explicit authenticated session/workspace and browser gates.
# Keep these values outside git and never pass them as command-line arguments.
FOUNDEROS_SMOKE_LOGIN_EMAIL=<smoke-login-email>
FOUNDEROS_SMOKE_LOGIN_PASSWORD=<smoke-login-password>
FOUNDEROS_E2E_BASE_URL=http://127.0.0.1:3000
FOUNDEROS_E2E_LOGIN_EMAIL=<browser-smoke-login-email>
FOUNDEROS_E2E_LOGIN_PASSWORD=<browser-smoke-login-password>

# Frontend build/runtime
# Server-only backend URL the Next.js app proxies /api/* and /health to, so the
# session cookie stays first-party (same-origin). Primary source; falls back to
# NEXT_PUBLIC_API_BASE_URL, then the local API at http://127.0.0.1:8765.
FOUNDEROS_API_PROXY_TARGET=http://127.0.0.1:8765
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8765

# Execution gates and GitHub repository scopes. Canonical `make local` requires
# live connectors, writes, and LLM execution to remain false; bounded runbooks
# own any temporary explicit opt-in.
ENABLE_WRITE_ACTIONS=<true-or-false>
REQUIRE_APPROVAL_FOR_WRITES=<true-or-false>
FOS_GITHUB_WRITE_ALLOWED_REPOS=<comma-separated-owner-repo>
FOS_GITHUB_SMOKE_REPO=<owner-repo>
FOS_GITHUB_SYNC_ALLOWED_REPOS=<comma-separated-owner-repo>
FOUNDEROS_GITHUB_REPOS=<comma-separated-owner-repo>

# Durable GitHub read queue. Defaults are safe for one API process; PostgreSQL
# leases coordinate several processes without running the same job twice.
FOUNDEROS_GITHUB_SYNC_WORKER_ENABLED=<true-or-false>
FOUNDEROS_GITHUB_SYNC_WORKER_CONCURRENCY=<worker-count-1-to-4>
FOUNDEROS_GITHUB_SYNC_WORKER_POLL_SECONDS=<poll-seconds>
FOUNDEROS_GITHUB_SYNC_JOB_LEASE_SECONDS=<lease-seconds>
FOUNDEROS_GITHUB_SYNC_JOB_MAX_ATTEMPTS=<attempt-count>
FOUNDEROS_GITHUB_SYNC_JOB_RETRY_BASE_SECONDS=<retry-base-seconds>

# Disaster recovery. Both paths must be outside the repository. The target must
# be founder-controlled storage physically independent from this machine.
FOUNDEROS_OFFSITE_BACKUP_DIR=<independent-off-device-backup-directory>
FOUNDEROS_OFFSITE_BACKUP_KEY_FILE=<separately-preserved-recovery-key-file>

# Read-only connector gates
FOUNDEROS_ENABLE_REAL_CONNECTORS=<true-or-false>
FOUNDEROS_REQUIRE_CONNECTOR_SCOPE=<true-or-false>
FOUNDEROS_CONNECTOR_NETWORK_TIMEOUT_SECONDS=<timeout-seconds>
FOUNDEROS_CONNECTOR_SYNC_LIMIT=<record-limit>
FOUNDEROS_CONNECTOR_BACKFILL_LIMIT=<record-limit>
FOUNDEROS_CONNECTOR_BACKFILL_MAX_DAYS=<day-count>
FOUNDEROS_JIRA_PROJECT_KEYS=<comma-separated-project-keys>

# LLM / AI
# ENABLE_LLM is only the server emergency kill switch. The OpenAI key, model,
# reasoning effort, output budget and data-policy acknowledgement belong only
# in /settings/ai and are stored encrypted per workspace. FounderOS sends only
# bounded normalized snapshot facts with store=false, strict JSON schema and
# local evidence validation. `store=false` does not by itself grant Zero Data
# Retention. The key is never returned to the browser.
ENABLE_LLM=<true-or-false>
FOUNDEROS_ASSISTANT_LLM_TIMEOUT_SECONDS=<provider-timeout-seconds>

# Provider credentials (OpenAI, GitHub, Jira, Gmail, Google Drive)
# There are intentionally no provider secret variables in this file.
# Configure, replace, verify and remove them in:
#   FounderOS → Settings → AI
#   FounderOS → Settings → Integrations

# Obsidian/local export
ENABLE_OBSIDIAN_EXPORT=<true-or-false>
FOUNDEROS_ENABLE_OBSIDIAN_BRIDGE=<true-or-false>
FOUNDEROS_OBSIDIAN_VAULT_NAME=<obsidian-vault-name>
FOUNDEROS_OBSIDIAN_VAULT_PATH=<obsidian-vault-path>
FOUNDEROS_OBSIDIAN_SYNC_MODE=<obsidian-sync-mode>
OBSIDIAN_VAULT_PATH=<obsidian-vault-path>
