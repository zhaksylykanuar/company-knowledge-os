{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "pep621", "docker-compose"],
  "dependencyDashboard": true,
  "timezone": "Asia/Almaty",
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Keep Python dependency updates stable enough for uv lockfile regeneration.",
      "matchManagers": ["pep621"],
      "matchDatasources": ["pypi"],
      "minimumReleaseAge": "3 days",
      "groupName": "python dependencies",
      "addLabels": ["python", "uv"]
    },
    {
      "description": "Keep frontend dependency updates stable enough for npm lockfile regeneration.",
      "matchManagers": ["npm"],
      "matchFileNames": ["web/package.json"],
      "minimumReleaseAge": "3 days",
      "groupName": "frontend dependencies",
      "addLabels": ["javascript", "npm"]
    },
    {
      "description": "Keep local datastore images immutable and update their tags and digests together.",
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "minimumReleaseAge": "3 days",
      "pinDigests": true,
      "groupName": "local datastore images",
      "addLabels": ["docker", "runtime"]
    }
  ]
}
